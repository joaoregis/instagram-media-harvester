{
  "manifest_version": 3,
  "name": "Media Harvester for Instagram",
  "version": "0.1.0",
  "description": "Baixa vídeos, reels e stories do Instagram com um clique.",
  "icons": { "128": "icon.svg" },
  "permissions": ["activeTab", "scripting", "downloads"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Baixar vídeo do Instagram", "default_icon": "icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-media-harvester@joao.reegiis",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
